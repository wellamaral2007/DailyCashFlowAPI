<Project Sdk="Microsoft.NET.Sdk.Web"> <!-- ? Sdk.Web habilitado para suportar o ecossistema do WebApplicationFactory -->

  <PropertyGroup>
    <!-- ? GOVERNANÇA: Alinhado no runtime do .NET 10.0 -->
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Library</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <!-- ?? FERRAMENTAS DE TESTE ATUALIZADAS E HOMOLOGADAS -->
    <PackageReference Include="Bogus" Version="35.6.1" />
    <PackageReference Include="MessagePack" Version="2.5.301" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="NBomber" Version="6.4.0" />
    <PackageReference Include="NBomber.Http" Version="6.0.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    
    <!-- ? EXECUTOR DE TESTES PARA O VS CODE / LINHA DE COMANDO -->
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

    <!-- ? ALINHAMENTO DE TESTES DE INTEGRAÇÃO WEB -->
    <!-- AJUSTE: Recuado para 8.0.10 para casar perfeitamente com os pacotes estáveis de persistência do projeto principal -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.10" />

    <!-- ? SUPORTE À CAMADA DE DADOS NOS TESTES DE INTEGRAÇÃO LOCAL -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.10" />
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Vínculo relacional estável para testar as classes do microsserviço unificado 
    <ProjectReference Include="..\DailyCashFlowBalanceMS\DailyCashFlowBalanceMS.csproj" /> -->
  </ItemGroup>

  <ItemGroup>
    <!-- Garante que o arquivo de configuração de banco/ambiente de teste vá para a pasta bin no build -->
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
