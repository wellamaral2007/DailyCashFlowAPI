<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 📌 GOVERNANÇA: Alinhado na versão estável do .NET 10.0 -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <CopyRefAssembliesToPublishDirectory>false</CopyRefAssembliesToPublishDirectory>
    <OutputType>Exe</OutputType>
    <!-- Força o compilador a usar as suas instruções do launchSettings/Functions se houver Main oculto -->
    <StartupObject>Program</StartupObject> 
  </PropertyGroup>

  <ItemGroup>
    <!-- 📌 FIXED: Ingestão do motor 3.0.0 oficial do Google Functions Framework para o .NET 10 -->
    <PackageReference Include="Google.Cloud.Functions.Framework" Version="3.0.0" />
    <PackageReference Include="Google.Cloud.Functions.Hosting" Version="3.0.0" />

    
    <!-- SDKs de infraestrutura e mensageria mapeados de forma explícita -->
    <PackageReference Include="Google.Cloud.PubSub.V1" Version="3.18.0" />
    <PackageReference Include="Google.Cloud.SecretManager.V1" Version="2.7.0" />
    
    <!-- Persistência e resiliência Outbound -->
    <PackageReference Include="EntityFramework" Version="6.5.1" />
    <PackageReference Include="Google.Events.Protobuf" Version="1.8.0" />
    <PackageReference Include="MySql.Data" Version="9.0.0" />
    <PackageReference Include="Polly" Version="8.5.0" />
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="9.0.0" />
    <PackageReference Include="StackExchange.Redis" Version="2.8.24" />
    
    <!-- Suporte nativo a OpenAPI do .NET 10 (Substituindo o Swashbuckle descontinuado) -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
      <Optimize>false</Optimize>
      <Configuration>Debug</Configuration>
      <Platform>AnyCPU</Platform>
      <DebugSymbols>true</DebugSymbols>
      <DebugType>full</DebugType>
      <EmbedAllSources>true</EmbedAllSources>
      <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
      <!-- Desativa completamente a otimização de variáveis do compilador -->
      <Deterministic>false</Deterministic> 
  </PropertyGroup>

  <ItemGroup>
    <!-- Vínculo relacional estável com a camada de reuso do Kernel Compartilhado -->
    <ProjectReference Include="..\BaseFramework\BaseFramework.csproj" />
  </ItemGroup>

</Project>
